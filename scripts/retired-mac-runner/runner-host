#!/bin/bash
set -euo pipefail
umask 077

task_program_root="$(cd -- "$(dirname -- "$0")" && pwd)"
test "$task_program_root" = "${LEDOVA_MANUAL_RUNNER_ROOT:?Set the explicit private manual runner root}"
export LIMA_HOME="$task_program_root/lima"
task_lima=/opt/homebrew/bin/limactl
task_base="${LEDOVA_MANUAL_BASE_VM:?Set the owned stopped base VM name}"
task_guest_user="${LEDOVA_MANUAL_GUEST_USER:?Set the isolated base guest user}"
[[ "$task_base" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]
[[ "$task_guest_user" =~ ^[a-z_][a-z0-9_-]*$ ]]
test "$#" -le 2 || { echo 'Too many arguments.' >&2; exit 2; }
task_action="${1:-status}"
task_profile="${2:-}"
case "$task_profile" in
    scoped) task_prefix=s ;;
    ordinary) task_prefix=o ;;
    *) if { test "$task_action" != status && test "$task_action" != drain; } || test -n "$task_profile"; then
           echo 'An exact scoped or ordinary profile is required.' >&2; exit 2
       fi ;;
esac
task_root="$task_program_root/slots/$task_profile"
task_active="$task_root/.active-vm"
if test -n "$task_profile"; then
    test "$(cd -- "$task_root" && pwd -P)" = "$task_root"
fi

state() {
    "$task_lima" list --json | jq -r --arg name "$1" 'select(.name == $name) | .status'
}

check_config() {
    "$task_lima" list --json | jq -e --arg name "$1" '
      select(.name == $name) | .config |
      .plain == true and ((.mounts // []) | length == 0) and
      .ssh.loadDotSSHPubKeys == false and .ssh.forwardAgent == false and
      .ssh.forwardX11 == false and .ssh.forwardX11Trusted == false and
      .containerd.system == false and .containerd.user == false and
      .propagateProxyEnv == false and .hostResolver.enabled == false and
      ((.env // {}) | length == 0) and
      ((.portForwards // []) | all(.ignore == true)) and
      ((.socketForwards // []) | length == 0) and
      .arch == "aarch64" and .cpus == 6 and .memory == "12GiB" and .disk == "60GiB"' >/dev/null
}

if test "$task_action" = status; then
    "$task_lima" list --json | jq '{name,status,arch:.config.arch,cpus:.config.cpus,memory:.config.memory}'
    for task_slot in scoped ordinary; do
        if test -f "$task_program_root/slots/$task_slot/.active-vm"; then
            cat "$task_program_root/slots/$task_slot/.active-vm"
        fi
    done
    exit
fi

if test "$task_action" = drain; then
    test -z "$task_profile" || { echo 'Drain applies to the fixed pool.' >&2; exit 2; }
    /opt/homebrew/bin/python3 "$task_program_root/runner-pool.py" drain
    echo 'Pool drain committed; existing busy jobs may finish.'
    exit
fi

case "$task_action" in prepare|discard) ;; *) echo 'Usage: runner-host [status|drain] | runner-host [prepare|discard] [scoped|ordinary]' >&2; exit 2 ;; esac
if test -e "$task_program_root/.pool-lock"; then
    test -f "$task_program_root/.pool-lock/pid"
    test "${LEDOVA_POOL_OWNER_PID:-}" = "$(cat "$task_program_root/.pool-lock/pid")" || { echo 'Ongoing pool owns lifecycle operations; drain it before manual changes.' >&2; exit 1; }
fi
mkdir "$task_root/.lifecycle-lock" || { echo 'Another operation or a stale lock exists; inspect it before retrying.' >&2; exit 1; }
task_pool_locked=false
task_lifecycle_locked=true
task_reservation_receipt=''
release_pool() {
    if test "$task_pool_locked" = true; then
        printf '%s\n' "$task_reservation_receipt" | /opt/homebrew/bin/python3 "$task_program_root/pool_reservation.py" release
        task_pool_locked=false
    fi
}
trap 'release_pool; if test "$task_lifecycle_locked" = true; then rmdir "$task_root/.lifecycle-lock"; fi' EXIT
if test -e "$task_program_root/.pool-lock"; then
    task_controller_pid="${LEDOVA_SESSION_OWNER_PID:-0}"
    while true; do
        set +e
        task_reservation_receipt="$(/opt/homebrew/bin/python3 "$task_program_root/pool_reservation.py" acquire "$task_profile" "$task_action" "$task_controller_pid" "$$")"
        task_reservation_status=$?
        set -e
        if test "$task_reservation_status" -eq 0; then break; fi
        if test "$task_reservation_status" -eq 75; then
            if test "$task_action" = prepare; then exit 75; fi
            sleep 1
            continue
        fi
        exit "$task_reservation_status"
    done
else
    echo 'A current master must own profile lifecycle operations.' >&2
    exit 1
fi
task_pool_locked=true
test ! -e "$task_program_root/.active-vm"
test ! -e "$task_program_root/.active-registration.json"
test ! -e "$task_program_root/.supervisor.pid"
test ! -e "$task_program_root/.lifecycle-lock"
task_inventory="$("$task_lima" list --json)"
task_expected="$task_base"
for task_slot in scoped ordinary; do
    task_slot_root="$task_program_root/slots/$task_slot"
    test "$(cd -- "$task_slot_root" && pwd -P)" = "$task_slot_root"
    if test -e "$task_slot_root/.active-vm"; then
        task_slot_vm="$(cat "$task_slot_root/.active-vm")"
        case "$task_slot" in scoped) task_slot_prefix=s ;; ordinary) task_slot_prefix=o ;; esac
        [[ "$task_slot_vm" =~ ^$task_slot_prefix-[0-9a-f]{12}$ ]]
        task_expected="$task_expected"$'\n'"$task_slot_vm"
    elif test -e "$task_slot_root/.active-registration.json" || test -e "$task_slot_root/.supervisor.pid"; then
        echo 'A profile has unresolved state without its VM reservation.' >&2; exit 1
    fi
done
test -z "$(find "$task_program_root/slots" -mindepth 1 -maxdepth 1 ! -name scoped ! -name ordinary -print)"
task_actual="$(jq -r '.name' <<<"$task_inventory" | sort)"
test "$task_actual" = "$(sort <<<"$task_expected")" || { echo 'Unrecorded or missing VM; inspect the private pool.' >&2; exit 1; }


if test "$task_action" = prepare; then
    test ! -e "$task_root/.supervisor.pid" || { echo 'Inspect the recorded session controller before preparing another.' >&2; exit 1; }
    test ! -e "$task_active" || { echo 'Dispose of the recorded clone before preparing another.' >&2; exit 1; }
    test "$(state "$task_base")" = Stopped
    check_config "$task_base"
    test ! -e "$task_program_root/.drain" || { echo 'Pool is draining; new preparation is disabled.' >&2; exit 1; }
    task_vm="$task_prefix-$(/usr/bin/openssl rand -hex 6)"
    printf '%s\n' "$task_vm" > "$task_active"
    "$task_lima" clone --tty=false "$task_base" "$task_vm"
    check_config "$task_vm"
    release_pool
    "$task_lima" start --tty=false --timeout=15m "$task_vm"
    "$task_lima" shell --tty=false --workdir /opt/actions-runner "$task_vm" bash -lc '
      set -e
      test -z "$(find /opt/actions-runner -maxdepth 1 \( -name .runner -o -name ".credentials*" -o -name _work \) -print)"
      test ! -d /Users
      test -z "$SSH_AUTH_SOCK"
      test -z "$(findmnt -rn -t virtiofs,9p,fuse.sshfs)"
      sudo install -d -o "$1" -g "$1" -m 755 /opt/hostedtoolcache
      sudo runuser -u "$1" -- test -w /opt/hostedtoolcache
      sudo runuser -u "$1" -- docker info >/dev/null
      sudo runuser -u "$1" -- gcc --version
      /opt/actions-runner/bin/Runner.Listener --version' runner-host "$task_guest_user"
    printf 'Prepared unregistered clone: %s. No listener or job started.\n' "$task_vm"
    exit
fi

test -f "$task_active"
test ! -f "$task_root/.active-registration.json" || { echo 'Remove the owned GitHub registration through its session controller before disposal.' >&2; exit 1; }
task_vm="$(cat "$task_active")"
[[ "$task_vm" =~ ^$task_prefix-[0-9a-f]{12}$ ]]
test -f "$task_root/.supervisor.pid"
test "${LEDOVA_SESSION_OWNER_PID:-}" = "$(cat "$task_root/.supervisor.pid")" || { echo 'Disposal controller ownership changed.' >&2; exit 1; }
task_state="$(state "$task_vm")"
test -n "$task_state" || { echo 'Recorded clone is absent; reconcile the receipt manually.' >&2; exit 1; }
task_evidence="$task_root/evidence/$task_vm"
mkdir -p "$task_evidence"
if test "$task_state" = Running; then
    "$task_lima" shell --tty=false --workdir /opt/actions-runner "$task_vm" bash -lc '
      set -e
      if pgrep -x Runner.Listener >/dev/null || pgrep -x Runner.Worker >/dev/null; then
        echo "Runner processes remain; wait for the owned job to finish before disposal." >&2
        exit 1
      fi
      task_logs=(var/log/cloud-init-output.log)
      if test -d /opt/actions-runner/_diag; then task_logs+=(opt/actions-runner/_diag); fi
      sudo tar -czf /tmp/ledova-runner-diagnostics.tar.gz -C / "${task_logs[@]}"
      sudo chown "$1:$1" /tmp/ledova-runner-diagnostics.tar.gz' runner-host "$task_guest_user"
    "$task_lima" copy --tty=false --backend=scp "$task_vm:/tmp/ledova-runner-diagnostics.tar.gz" "$task_evidence/guest-diagnostics.tar.gz"
    "$task_lima" stop --tty=false "$task_vm"
elif test "$task_state" != Stopped; then
    echo 'Clone state needs inspection; refusing deletion.' >&2
    exit 1
elif test ! -f "$task_evidence/guest-diagnostics.tar.gz"; then
    echo 'Stopped clone has no retained diagnostics; collect them before deletion.' >&2
    exit 1
fi
"$task_lima" delete --tty=false --force "$task_vm"
test -z "$(state "$task_vm")"
printf '%s\n' "$task_reservation_receipt" | /opt/homebrew/bin/python3 "$task_program_root/pool_reservation.py" finish-disposal "${LEDOVA_SESSION_INSPECTION_SEEN:?}"
rmdir "$task_root/.lifecycle-lock"
task_lifecycle_locked=false
release_pool
printf 'Disposed of %s and its disk; retained private diagnostics.\n' "$task_vm"
