ARG NODE_VERSION=22.22.2
FROM node:${NODE_VERSION}-alpine AS build

ARG NPM_VERSION=11.5.2
RUN npm install -g npm@${NPM_VERSION}

WORKDIR /usr/src/app
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./

# Vite embeds the app's address at build time, and .env files stay out of the
# Docker context. Pass the deployment's dashboard origin explicitly.
ARG VITE_LEDOVA_URL=http://localhost:5174
ENV VITE_LEDOVA_URL=${VITE_LEDOVA_URL}
ARG VITE_BASE=/
RUN npm run build -- --base=${VITE_BASE}

FROM build AS artifact-files
RUN mkdir -p /artifact/site-dist/site-assets \
    && cp -a dist/. /artifact/site-dist/site-assets/ \
    && rm /artifact/site-dist/site-assets/index.html \
    && cp dist/index.html /artifact/site-dist/ \
    && for path in robots.txt sitemap.xml _redirects icons screenshots; do \
         cp -a "dist/$path" /artifact/site-dist/; \
       done

FROM scratch AS artifact
COPY --from=artifact-files /artifact/site-dist /site-dist

FROM nginx:stable-alpine AS production
COPY .deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /usr/src/app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --no-verbose --tries=1 --spider http://localhost:80/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
