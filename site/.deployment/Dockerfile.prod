FROM node:22.15.1-alpine AS build

RUN npm install -g npm@11.5.2

WORKDIR /usr/src/app
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./

# Vite embeds the app's address at build time, and .env files stay out of the
# Docker context. Pass the deployment's dashboard origin explicitly.
ARG VITE_LEDOVA_URL=http://localhost:5174
ENV VITE_LEDOVA_URL=${VITE_LEDOVA_URL}
RUN npm run build

FROM nginx:stable-alpine AS production
COPY .deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /usr/src/app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --no-verbose --tries=1 --spider http://localhost:80/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
